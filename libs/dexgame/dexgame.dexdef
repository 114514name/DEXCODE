# dexgame.dexdef — dexgame 游戏引擎接口(动态链接版)
#
# 用法:
#   include "dexgame";
#   eng_init("我的游戏", 1280, 720, 1);
#   while eng_running() {
#       eng_frame_begin();
#       eng_rect(10, 10, 100, 50, 0xFFFF0000);
#       eng_frame_end();
#   }
#   eng_shutdown();
#
# 注:
#   - 本文件使用**值数组调用约定**(abi value_array)。原生侧签名为
#     int64_t eng_xxx(const DexValue *args, int argc);
#     这样参数个数可以超过 3(eng_draw_uv 有 10 个参数)。
#     详见 docs/SPEC.md 4.5 与 libs/dexgame/dexvalue.h。
#   - 帧循环由 C 侧拥有:frame_begin 抽消息/清屏,frame_end 提交并 Present。
#   - 任何失败都会返回负数,原因用 eng_last_error() 取(**不静默失败**)。
#   - 颜色统一为 0xAARRGGBB。

abi value_array;
refer "libdexgame.dll";

# ---- 生命周期 ----
extern func eng_init(title: string, w: int, h: int, vsync: int) -> int;
extern func eng_init_offscreen(w: int, h: int) -> int;
extern func eng_shutdown() -> int;
extern func eng_running() -> int;
extern func eng_request_close() -> int;
# 库版本号:宿主与库不同步时便于排查(1 = M1 仅渲染,2 = M2 加实体/组件/场景)。
extern func eng_version() -> int;

# ---- 帧 ----
extern func eng_frame_begin() -> int;
extern func eng_frame_end() -> int;
extern func eng_frame_index() -> int;
extern func eng_now_ms() -> int;
extern func eng_width() -> int;
extern func eng_height() -> int;
extern func eng_set_clear_color(color: int) -> int;
# IDE 视口预览:临时覆盖相机(不写进场景)。on=0 恢复用场景里的相机。
extern func eng_set_view(on: int, x: float, y: float, zoom: float) -> int;
extern func eng_set_vsync(on: int) -> int;
extern func eng_set_target_fps(fps: int) -> int;

# ---- 纹理 ----
extern func eng_tex_load(path: string) -> int;
extern func eng_tex_solid(w: int, h: int, color: int) -> int;
extern func eng_tex_free(tex: int) -> int;
extern func eng_tex_valid(tex: int) -> int;
extern func eng_tex_width(tex: int) -> int;
extern func eng_tex_height(tex: int) -> int;

# ---- 绘制 ----
# 注:DexLang 编译器**精确校验参数个数**(没有可选尾参),所以这里必须把每个形参都
# 声明出来。要按纹理原始尺寸绘制,用 eng_tex_width/eng_tex_height 取尺寸后传入。
extern func eng_draw(tex: int, x: float, y: float, w: float, h: float, color: int) -> int;
extern func eng_draw_uv(tex: int, x: float, y: float, w: float, h: float, u0: float, v0: float, u1: float, v1: float, color: int) -> int;
extern func eng_rect(x: float, y: float, w: float, h: float, color: int) -> int;

# ---- 实体 / 组件 / 场景(M2)----
# 实体 id 带世代:释放后旧 id 立即失效,槽位复用时世代递增,不会误指新对象。
extern func eng_object_new() -> int;
extern func eng_object_free(obj: int) -> int;
extern func eng_object_alive(obj: int) -> int;
extern func eng_object_count() -> int;
extern func eng_object_id_at(index: int) -> int;
extern func eng_scene_clear() -> int;

# 实体名(最多 31 字符)。语言**没有全局变量**:回调函数(on_update 等)
# 看不到主程序的 let,所以跨帧状态要么放组件里、要么用名字找实体。
extern func eng_set_name(obj: int, name: string) -> int;
extern func eng_name(obj: int) -> string;
extern func eng_find(name: string) -> int;

# 组件名用字符串(如 "sprite"),便于生成的代码与 IDE 可读。
extern func eng_attach(obj: int, comp: string) -> int;
extern func eng_detach(obj: int, comp: string) -> int;
extern func eng_has(obj: int, comp: string) -> int;

extern func eng_set_i(obj: int, comp: string, field: string, value: int) -> int;
extern func eng_set_f(obj: int, comp: string, field: string, value: float) -> int;
extern func eng_set_s(obj: int, comp: string, field: string, value: string) -> int;
extern func eng_get_i(obj: int, comp: string, field: string) -> int;
extern func eng_get_f(obj: int, comp: string, field: string) -> float;
extern func eng_get_s(obj: int, comp: string, field: string) -> string;

# 世界坐标(沿 transform 的 parent 链累加)
extern func eng_world_x(obj: int) -> float;
extern func eng_world_y(obj: int) -> float;

# 把场景里所有 (transform + sprite) 画出来;相机取第一个 active 的 camera。
extern func eng_draw_scene() -> int;

# 场景读写:JSON(编辑期格式)。未知字段会被跳过,所以新旧版本可以互相读。
extern func eng_scene_save(path: string) -> int;
extern func eng_scene_load(path: string) -> int;
extern func eng_scene_load_json(text: string) -> int;
extern func eng_scene_json() -> string;

# 描述符表自省(节点式 IDE 靠它生成属性面板)
extern func eng_comp_count() -> int;
extern func eng_comp_name_at(index: int) -> string;
extern func eng_field_count(comp: string) -> int;
extern func eng_field_name(comp: string, index: int) -> string;
extern func eng_field_type(comp: string, index: int) -> int;
extern func eng_field_persist(comp: string, index: int) -> int;

# ---- 物理(M3)----
# 固定步长(默认 120Hz)+ 累加器;默认由 eng_frame_begin() 自动推进,
# eng_physics_set_auto(0) 后改由用户每帧调 eng_physics_step(dt)。
extern func eng_physics_set_auto(on: int) -> int;
extern func eng_physics_set_gravity(gx: float, gy: float) -> int;
extern func eng_physics_set_step(hz: float) -> int;
extern func eng_physics_step(dt: float) -> int;
extern func eng_physics_step_once() -> int;
extern func eng_physics_pause(on: int) -> int;
extern func eng_physics_alpha() -> float;
extern func eng_physics_substeps() -> int;
extern func eng_dt() -> float;
extern func eng_time() -> float;

# 运动:轴分离的 move-and-slide。返回位掩码(1 = X 向受阻,2 = Y 向受阻)。
extern func eng_move(obj: int, dx: float, dy: float) -> int;
extern func eng_on_ground(obj: int) -> int;
extern func eng_on_wall(obj: int) -> int;
extern func eng_on_ceiling(obj: int) -> int;
extern func eng_set_velocity(obj: int, vx: float, vy: float) -> int;
extern func eng_velocity_x(obj: int) -> float;
extern func eng_velocity_y(obj: int) -> float;
extern func eng_body_wake(obj: int) -> int;
extern func eng_body_sleeping(obj: int) -> int;

# 查询是**游标式**(DexLang 没有数组):begin 拿游标,next 逐个取(0 = 结束),
# 用完必须 end。mask = 0 表示不做 layer 筛选。
extern func eng_query_rect(x: float, y: float, w: float, h: float, mask: int) -> int;
extern func eng_query_circle(cx: float, cy: float, r: float, mask: int) -> int;
extern func eng_query_point(x: float, y: float, mask: int) -> int;
extern func eng_query_next(cursor: int) -> int;
extern func eng_query_count(cursor: int) -> int;
extern func eng_query_at(cursor: int, index: int) -> int;
extern func eng_query_reset(cursor: int) -> int;
extern func eng_query_end(cursor: int) -> int;
extern func eng_overlap(a: int, b: int) -> int;

# 射线/扫掠:返回 1/0,命中详情在**结果槽**里(每次查询都覆盖它)。
extern func eng_raycast(x: float, y: float, dx: float, dy: float, dist: float, mask: int, ignore: int) -> int;
extern func eng_sweep_box(x: float, y: float, hw: float, hh: float, dx: float, dy: float, mask: int, ignore: int) -> int;
extern func eng_hit_obj() -> int;
extern func eng_hit_tile() -> int;
extern func eng_hit_x() -> float;
extern func eng_hit_y() -> float;
extern func eng_hit_nx() -> float;
extern func eng_hit_ny() -> float;
extern func eng_hit_t() -> float;

# 有 body 的实体默认做渲染插值(120Hz 物理 + 165Hz 渲染不插值会顿)。
extern func eng_render_set_interp(on: int) -> int;

# 瓦片地图:图块数据不进场景 JSON(可能几万格),只存 path;字符串加载的图要
# 自己用 eng_tilemap_save_csv() 落盘。非空格子默认实心,可用 set_solid 改。
extern func eng_tilemap_load_csv(obj: int, text: string) -> int;
extern func eng_tilemap_load_file(obj: int, path: string) -> int;
extern func eng_tilemap_save_csv(obj: int, path: string) -> int;
extern func eng_tilemap_tile(obj: int, col: int, row: int) -> int;
extern func eng_tilemap_cols(obj: int) -> int;
extern func eng_tilemap_rows(obj: int) -> int;
extern func eng_tilemap_set_solid(obj: int, tile: int, solid: int) -> int;
extern func eng_tilemap_is_solid(obj: int, tile: int) -> int;
extern func eng_tilemap_solid_at(obj: int, wx: float, wy: float) -> int;

# ---- 输入(M4)----
# 两层:底层轮询(eng_key_*/eng_mouse_*/eng_pad_*)与动作映射(eng_action_*)。
# **按键码是统一编号**,动作可以混绑键盘/鼠标/手柄而逻辑不变:
#   0..255   Win32 虚拟键(65='A'、32=空格、37/38/39/40=方向键、13=回车、27=Esc)
#   256..258 鼠标左/右/中键
#   300..313 手柄:300=上 301=下 302=左 303=右 304=Start 305=Back 306=LS 307=RS
#                    308=LB 309=RB 310=A 311=B 312=X 313=Y
#   400+i    手柄轴 i 正向;500+i 轴 i 负向(i:0=LX 1=LY 2=RX 3=RY 4=LT 5=RT)
extern func eng_key_down(code: int) -> int;
extern func eng_key_pressed(code: int) -> int;
extern func eng_key_released(code: int) -> int;
extern func eng_mouse_x() -> float;
extern func eng_mouse_y() -> float;
extern func eng_mouse_world_x() -> float;
extern func eng_mouse_world_y() -> float;
extern func eng_mouse_down(btn: int) -> int;
extern func eng_mouse_pressed(btn: int) -> int;
extern func eng_mouse_released(btn: int) -> int;
extern func eng_mouse_wheel() -> int;
extern func eng_pad_connected() -> int;
extern func eng_pad_axis(axis: int) -> float;

# 动作:一个动作最多绑 4 个来源;eng_action_value 取绑定的模拟量(摇杆)
extern func eng_action_bind(action: string, code: int) -> int;
extern func eng_action_unbind(action: string) -> int;
extern func eng_action_down(action: string) -> int;
extern func eng_action_pressed(action: string) -> int;
extern func eng_action_released(action: string) -> int;
extern func eng_action_value(action: string) -> float;
extern func eng_action_bound(action: string) -> int;
extern func eng_action_count() -> int;
extern func eng_action_name_at(index: int) -> string;
extern func eng_action_code(action: string, slot: int) -> int;

# 合成输入:无人值守测试与 IDE 的"脚本化试玩"要用它(不碰真实设备)
extern func eng_input_feed(code: int, down: int) -> int;
extern func eng_input_feed_axis(axis: int, value: float) -> int;
extern func eng_input_feed_mouse(x: float, y: float) -> int;
extern func eng_input_feed_wheel(delta: int) -> int;
extern func eng_input_clear() -> int;

# ---- 音频(M4,XAudio2)----
# 声音资源按**路径缓存**(eng_sound_load 同一路径返回同一个 id);播放返回"播放实例"id,
# 同一个声音可以同时响多次(脚步/子弹)。没有声卡时 eng_audio_ok() 返回 0,
# 播放调用会失败并给出原因,不会崩。
extern func eng_audio_ok() -> int;
extern func eng_audio_set_master_volume(volume: float) -> int;
extern func eng_audio_master_volume() -> float;
extern func eng_sound_load(path: string) -> int;
extern func eng_sound_free(sound: int) -> int;
extern func eng_sound_duration(sound: int) -> float;
extern func eng_sound_sample_rate(sound: int) -> int;
extern func eng_sound_channels(sound: int) -> int;
extern func eng_sound_bits(sound: int) -> int;
extern func eng_sound_path(sound: int) -> string;
extern func eng_sound_count() -> int;
extern func eng_sound_play(sound: int, loop: int, volume: float) -> int;
extern func eng_voice_stop(voice: int) -> int;
extern func eng_voice_playing(voice: int) -> int;
extern func eng_voice_set_volume(voice: int, volume: float) -> int;
extern func eng_voice_sound(voice: int) -> int;
extern func eng_audio_playing_count() -> int;
extern func eng_audio_stop_all() -> int;

# ---- 文字(M4-c,DirectWrite + 字形图集)----
# 字号是**像素**高度(逻辑像素)。同一家族+同字号复用同一个字体句柄。
# 度量按字形缓存(不会每帧重新排版);`\n` 支持,测量取最宽一行。
# 一期不做换行/对齐/富文本。中文可以显示(走系统字体集合与 CJK 回退)。
extern func eng_text_ok() -> int;
extern func eng_text_glyph_count() -> int;
extern func eng_text_font_count() -> int;
extern func eng_font_load(family: string, size: float) -> int;
extern func eng_font_free(font: int) -> int;
extern func eng_font_line_height(font: int) -> float;
extern func eng_font_ascent(font: int) -> float;
extern func eng_font_family(font: int) -> string;
extern func eng_font_size(font: int) -> float;
extern func eng_text_width(font: int, text: string) -> float;
extern func eng_text_height(font: int, text: string) -> float;
extern func eng_text(x: float, y: float, font: int, text: string, color: int) -> int;

# ---- 颜色辅助 ----
# DexLang 没有位移运算,无法自行从 r/g/b/a 拼出 0xAARRGGBB,故提供此函数。
extern func eng_rgba(r: int, g: int, b: int, a: int) -> int;

# ---- 测试 / 调试 ----
extern func eng_pixel(x: int, y: int) -> int;
extern func eng_save_bmp(path: string) -> int;
extern func eng_last_error() -> string;
extern func eng_clear_error() -> int;
extern func eng_gpu_name() -> string;
extern func eng_vram_mb() -> int;
