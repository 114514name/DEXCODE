# ============================================================
# DEXCODE .gitattributes
#
# 目的:锁定文本编码与换行,防止再次发生"中文注释被重写损坏"。
# 背景:vm.c 曾有 118 行中文注释被 PowerShell Set-Content 以 GBK
#       误解码后重写为 UTF-8 而损坏,只能靠打包目录的旧快照恢复。
# ============================================================

# 所有文本文件视为 UTF-8,且不做换行转换(仓库内统一 LF)
* text=auto eol=lf

# 明确声明为文本的类型
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.dex   text eol=lf
*.dexdef text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 字节码是二进制,绝不做换行/编码处理
*.dexbc binary
*.do    binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.lib   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.webp  binary
*.mp3   binary
*.wav   binary
*.ogg   binary

# 生成产物不参与 diff 统计
*.dxasm linguist-generated=true
