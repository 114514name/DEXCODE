     ],
     "text": "",
     "text_pos": 0,
     "text_mode": 0,
     "text_speed": 60,
     "show_name": 1,
     "name": "",
     "use_char": 0,
     "char_idx": -1,
     "state_idx": 0,
     "lines": [
      [
       0,
       "人类的三大欲望是食欲、性欲、睡眠欲"
      ],
      [
       0,
       "其中，食欲是人为了维持生命所必要的行动"
      ],
      [
       -1,
       "对于动物来说,可以获得快感,是优先要进行的行为"
      ],
      [
       0,
       "依靠进食可以获得满足感,并且,吃到美味食物的时候"
      ],
      [
       -1,
       "会感到喜悦,精神上面会受到好的影响"
      ],
      [
       -1,
       "此外,有人在美食方面付出极大心血"
      ],
      [
       -1,
       "我们通常把这种人称之为美食家"
      ],
      [
       -1,
       "而本餐厅,专门为那些厌倦世间常见美食的人,量身定制,提供符合他们身份的美食"
      ],
      [
       -1,
       "欢迎光临!"
      ],
      [
       1,
       "我是从朋友那里听说的...."
      ],
      [
       -1,
       "我知道了,请这边坐"
      ]
     ],
